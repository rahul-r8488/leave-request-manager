managed implementation in class zbp_i_leave unique;
strict ( 2 );
with draft;

define behavior for ZI_LEAVE alias Leave
persistent table zlr_leave
draft table zlr_leave_d
lock master total etag LastChangedAt
authorization master ( global )
etag master LocalLastChangedAt
{
  create;
  update;
  delete;

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare
  {
    validation validateDates;
  }

  field ( numbering : managed, readonly ) LeaveId;
  field ( readonly ) LeaveDays, Status, CreatedBy, CreatedAt, LastChangedBy, LastChangedAt, LocalLastChangedAt;
  field ( mandatory ) EmployeeName, LeaveType, StartDate, EndDate;

  determination setInitialStatus on modify { create; }
  determination calculateDays on modify { create; field StartDate, EndDate; }
  validation validateDates on save { create; update; field StartDate, EndDate; }

  action ( features : instance ) approve result [1] $self;
  action ( features : instance ) reject result [1] $self;

  mapping for zlr_leave corresponding
  {
    LeaveId            = leave_id;
    EmployeeName       = employee_name;
    LeaveType          = leave_type;
    StartDate          = start_date;
    EndDate            = end_date;
    LeaveDays          = leave_days;
    Reason             = reason;
    Status             = status;
    CreatedBy          = created_by;
    CreatedAt          = created_at;
    LastChangedBy      = last_changed_by;
    LastChangedAt      = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }
}